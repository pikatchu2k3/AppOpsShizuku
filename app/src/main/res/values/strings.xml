    <!-- Stealth-Modus (Feature 2b) -->
    <string name="stealth_title">Stealth-Modus</string>
    <string name="stealth_description">Patcht die App so, dass sie dauerhaft nicht im Verlauf (letzte Apps) erscheint. Optional wird zusätzlich das Launcher-Icon entfernt. Die App wird dabei neu signiert.</string>
    <string name="stealth_exclude_from_recents">Im Verlauf (letzte Apps) verstecken</string>
    <string name="stealth_remove_launcher_icon">Launcher-Icon ausblenden</string>
    <string name="stealth_secure_snapshot">Inhalt im Verlauf schwärzen (Inkognito, wie Banking-Apps)</string>
    <string name="stealth_require_vpn">Nur mit aktivem VPN ausführbar (VPN-Pflicht)</string>
    <string name="stealth_vault_calc">Als Taschenrechner verstecken (Vault)</string>
    <string name="stealth_vault_pin_hint">Vault-PIN (Ziffern, 4–10; leer = 12345)</string>
    <string name="stealth_vault_pin_invalid">PIN muss 4–10 Ziffern enthalten</string>
    <string name="stealth_vault_no_launcher">Vault: Launcher-Activity der Ziel-App nicht gefunden</string>
    <string name="stealth_spoof_title">Device-Spoofing (app-spezifisch)</string>
    <string name="stealth_spoof_description">Spooft Geräte-Identitäts-Werte NUR in dieser App (Smali-Call-Site-Rewriting, kein Root nötig). Betrifft ausschließlich die gepatchte App, nicht das System.</string>
    <string name="stealth_spoof_build">Geräte-Fingerprint spoofen (Build)</string>
    <string name="stealth_spoof_random">🎲 Zufälliges Geräteprofil wählen</string>
