<?xml version="1.0" encoding="utf-8"?>
<!-- Werkzeug-Karte im Bereich "Werkzeuge" (gleicher Verlaufs-Stil wie die App-Karten). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_card_icon"
        android:padding="14dp">

        <ImageView
            android:id="@+id/toolIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:tint="@color/card_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/toolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/card_text"
            android:textSize="19sp"
            tools:text="Netzverkehr" />

        <TextView
            android:id="@+id/toolDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/card_text_dim"
            android:textSize="14sp"
            tools:text="Wer sendet im Hintergrund?" />
    </LinearLayout>
</LinearLayout>
