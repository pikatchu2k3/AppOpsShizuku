<?xml version="1.0" encoding="utf-8"?>
<!-- Hauptansicht im Design "Sternenhimmel": Hintergrund, Kopfzeile mit runden Glas-Knoepfen,
     drei Bereiche (Apps / Werkzeuge / Einstellungen) und eine schwebende Pill-Navigation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <de.minipc.appopsshizuku.ui.StarfieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kopfzeile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/header_title"
                    android:textColor="@color/on_glass"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/on_glass_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/menu_change_log"
                android:src="@drawable/ic_history"
                app:tint="@color/on_glass" />

            <ImageButton
                android:id="@+id/btnTune"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/header_tune"
                android:src="@drawable/ic_tune"
                app:tint="@color/on_glass" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/search_hint"
                android:src="@drawable/ic_search"
                app:tint="@color/on_glass" />
        </LinearLayout>

        <!-- Suche (ueber den Lupen-Knopf ein-/ausgeblendet) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:hint="@string/search_hint"
            android:visibility="gone"
            app:boxBackgroundColor="@color/glass_fill"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/on_glass_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/on_glass" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Aktiver Filter (Tipp = zuruecksetzen) -->
        <TextView
            android:id="@+id/filterPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill_selected"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/on_pill_selected"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Filter: Geändert  ✕"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== Bereich Apps ===== -->
            <LinearLayout
                android:id="@+id/panelApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shizukuHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:padding="14dp"
                    android:textColor="@color/on_glass"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Shizuku nicht verbunden – zu den Einstellungen"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/backupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="6dp"
                    android:padding="10dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/driftCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/driftText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/driftRestore"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/drift_restore" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/appList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="120dp"
                        android:scrollbars="none" />

                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_blocked"
                            app:tint="@color/on_glass_dim" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/empty_no_apps"
                            android:textColor="@color/on_glass"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/empty_try_search"
                            android:textColor="@color/on_glass_dim" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- ===== Bereich Werkzeuge ===== -->
            <ScrollView
                android:id="@+id/panelTools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="120dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/toolsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- ===== Bereich Einstellungen ===== -->
            <ScrollView
                android:id="@+id/panelSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="120dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Shizuku-Status (Farben setzt MainActivity.updateStatus) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statusCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statusTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                                <TextView
                                    android:id="@+id/statusDetail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="?attr/textAppearanceBodySmall" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/connectButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/btn_connect" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/settingQuarantine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_quarantine"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_quarantine_hint"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/settingDynamicColor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/menu_dynamic_color"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_dynamic_hint"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/settingStarAnimation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/menu_star_animation"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_star_animation_hint"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_backup_title"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_backup_hint"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settingExport"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/menu_export_profiles" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settingImport"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/menu_import_profiles" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/settingsBackupStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:padding="10dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/standing_title"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/standingStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/standingButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/owner_title"
                            android:textColor="@color/on_glass"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ownerStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_glass_dim"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ownerButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settingsAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="@color/on_glass_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Schwebende Navigation -->
    <LinearLayout
        android:id="@+id/pillNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_nav"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/navApps"
            style="@style/PillNavItem">

            <ImageView
                android:id="@+id/navAppsIcon"
                android:importantForAccessibility="no"
                style="@style/PillNavIcon"
                android:src="@drawable/ic_apps" />

            <TextView
                android:id="@+id/navAppsLabel"
                style="@style/PillNavLabel"
                android:text="@string/tab_apps" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTools"
            style="@style/PillNavItem">

            <ImageView
                android:id="@+id/navToolsIcon"
                android:importantForAccessibility="no"
                style="@style/PillNavIcon"
                android:src="@drawable/ic_tools" />

            <TextView
                android:id="@+id/navToolsLabel"
                style="@style/PillNavLabel"
                android:text="@string/tab_tools" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            style="@style/PillNavItem">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:importantForAccessibility="no"
                style="@style/PillNavIcon"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/navSettingsLabel"
                style="@style/PillNavLabel"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
