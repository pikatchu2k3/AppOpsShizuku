<?xml version="1.0" encoding="utf-8"?>
<!-- Reiter "Tarnung": komplette Stealth-Karte (umgezogen aus ComponentsActivity).
     Klonen/Stealth-Patch mit allen Optionen: Recents, Icon entfernen, Secure
     Snapshot, VPN-Guard, Vault, Label, Spoofing/Geraeteprofil, Apply, Restore. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Beta-Hinweis: fest sichtbar, nicht wegklickbar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stealthBetaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorWarning"
            app:cardBackgroundColor="?attr/colorWarningContainer">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/stealth_beta_notice"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnWarningContainer" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Stealth-Modus: Launcher-Icon entfernen (AXML), App bleibt startbar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stealthCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stealth_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_description"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthExcludeFromRecentsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="@string/stealth_exclude_from_recents"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthRemoveLauncherIconSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_remove_launcher_icon"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthSecureSnapshotSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_secure_snapshot"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthRequireVpnSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_require_vpn"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthVaultCalcSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_vault_calc"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/stealthVaultPinLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/stealth_vault_pin_hint"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/stealthVaultPinInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberPassword"
                        android:maxLength="10" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/stealth_clone_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_clone_description"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthCloneSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/stealth_clone_switch"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/stealthClonePkgLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/stealth_clone_pkg_hint"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/stealthClonePkgInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="abcdefghijklmnopqrstuvwxyz0123456789._"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/stealthCloneLabelLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/stealth_clone_label_hint"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/stealthCloneLabelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stealth_signature_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_clone_limits"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/stealthCloneCollision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <!-- Tracker abschalten (Beta) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/stealth_tracker_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_tracker_description"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/stealthTrackerDetected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_tracker_scanning"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthTrackerAds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/net_group_ads"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthTrackerAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/net_group_analytics"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthTrackerAttribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/net_group_attribution"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <!-- Berechtigungen entfernen (Beta) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/strip_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/strip_description"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/stealthStripDeclared"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/strip_declared_scanning"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_offline"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripAdId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_ad_id"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripAppList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_app_list"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_location"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_phone"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/stealthStripAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/strip_accounts"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/stealth_spoof_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_spoof_description"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthSpoofBuildSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stealth_spoof_build"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:id="@+id/spoofBuildFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/spoofRandomButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/stealth_spoof_random"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/stealth_spoof_model_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/spoofModelInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/stealth_spoof_manufacturer_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/spoofManufacturerInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/stealth_spoof_fingerprint_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/spoofFingerprintInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthSpoofAndroidIdSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_spoof_android_id"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stealthSpoofTelephonySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stealth_spoof_telephony"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stealthApplyButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stealth_apply" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stealthRestoreButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/stealth_restore" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
