<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App-Liste anzeigen (alle installierten Apps, Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Foreground-Service fuer den Stealth-Patch (laeuft auch bei App-Wechsel weiter) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- WakeLock: CPU nicht in Suspend gehen lassen waehrend des Patches -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Notification-Berechtigung (Android 13+): OHNE diesen Manifest-Eintrag
         ist der Schalter in den App-Einstellungen ausgegraut/nicht vorhanden
         (realer User-Fall 08/2026: "Benachrichtigungen kann ich nicht erlauben") -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Feature 3 Screen-Off-Exit: Android 14+ verlangt fuer jeden Vordergrunddienst einen Typ.
         dataSync ist ab Android 15 auf 6 h/Tag begrenzt und passt inhaltlich nicht;
         "specialUse" ist der einzige passende Typ ohne Zeitlimit und braucht genau dieses Recht. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- WLAN-Name (SSID) fuer Automatik-Regeln lesen. Android verlangt dafuer den Standort FUER
         DIESE App; die App hat selbst keinen Netzzugriff. Wird erst bei der ersten WLAN-Regel
         zur Laufzeit abgefragt, nicht beim Start. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Nur die ART der Verbindung lesen (WLAN ja/nein) - KEIN Internetzugriff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Automatik-Regeln: ungefaehre Weckrufe planen (keine Exact-Alarm-Berechtigung noetig). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- Dauerrecht: wird EINMAL per Shizuku erteilt (pm grant) und bleibt ueber Neustarts. Damit
         funktionieren privates DNS und das Entziehen von Bedienungshilfen ohne laufendes Shizuku. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Neustart erkennen, um auf still inaktiven Schutz hinzuweisen (Shizuku laeuft nach dem
         Neustart noch nicht). Erlaubt ohne Nutzerfreigabe. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Nur bei Bedarf": erkennen, wann die geoeffnete App verlassen wurde (Nutzungsereignisse).
         Wird per Shizuku fuer die EIGENE App erteilt (cmd appops set ... GET_USAGE_STATS allow). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AppOpsApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppOpsShizuku"
        android:largeHeap="true">

        <!-- Shizuku 13+: Provider fuer den Permission-Request-Flow -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppDetailActivity"
            android:exported="false" />
        <activity
            android:name=".AppOpsActivity"
            android:exported="false" />
        <activity
            android:name=".ComponentsActivity"
            android:exported="false" />
        <activity
            android:name=".PermissionOverviewActivity"
            android:exported="false" />

        <!-- "Nur bei Bedarf": Ziel der Launcher-Verknuepfung (gibt frei + startet die App).
             Nicht exportiert - angeheftete Verknuepfungen startet der Launcher im Namen dieser App. -->
        <activity
            android:name=".OnDemandLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AppOpsShizuku.Translucent" />

        <!-- "Nur bei Bedarf" fuer eigene Starter-Apps (z. B. AppDialer NXT): exportierter Zweiteingang.
             Der Aufrufer muss sich per startActivityForResult zu erkennen geben; eine neue Starter-App
             wird einmal beim Nutzer erfragt (OnDemandCallers). Freigegeben wird nur, was auf
             "Nur bei Bedarf" steht. -->
        <activity-alias
            android:name=".OnDemandExternalLaunch"
            android:exported="true"
            android:targetActivity=".OnDemandLaunchActivity">
            <intent-filter>
                <action android:name="de.minipc.appopsshizuku.action.OPEN_ON_DEMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".SystemActivity"
            android:exported="false" />

        <activity
            android:name=".ChangeLogActivity"
            android:exported="false" />

        <activity
            android:name=".NetUsageActivity"
            android:exported="false" />
        <activity
            android:name=".ActivityScanActivity"
            android:exported="false" />
        <activity
            android:name=".WorkProfileActivity"
            android:exported="false" />
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />
        <activity
            android:name=".AutoRulesActivity"
            android:exported="false" />
        <activity
            android:name=".AutoRuleEditActivity"
            android:exported="false" />

        <!-- Schnellstart-Kachel "Lockdown" (Kamera/Mikrofon fuer alle Nutzer-Apps). Nur das System
             darf sich binden (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".LockdownTileService"
            android:exported="true"
            android:icon="@drawable/ic_blocked"
            android:label="@string/lockdown_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Geraeteadmin: Profilbesitzer eines selbst angelegten Arbeitsprofils werden koennen. -->
        <receiver
            android:name=".ProfileOwnerReceiver"
            android:description="@string/workprofile_admin_desc"
            android:exported="true"
            android:label="@string/workprofile_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/profile_owner" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Automatik-Regeln: Weckruf (AlarmManager, explizit adressiert) + Neustart. -->
        <receiver
            android:name=".AutoRuleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hinweis nach Neustart: Schutz inaktiv, solange Shizuku nicht laeuft. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Stealth-Patch im Hintergrund (Foreground-Service, Fortschritt in Notification) -->
        <service
            android:name=".StealthPatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Feature 3 Screen-Off-Exit: SCREEN_ON/OFF sind ab Android 8 nicht per Manifest-Empfaenger
             empfangbar -> Empfaenger zur Laufzeit in diesem Dienst. Laeuft nur, solange
             mindestens eine App den Haken hat. -->
        <service
            android:name=".LifecycleScreenService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Beobachtet Bildschirm an/aus und das Verlassen vom Nutzer gewaehlter Apps, um sie anzuhalten bzw. wieder zu sperren (pm suspend / pm disable-user / am force-stop)." />
        </service>
    </application>
</manifest>
