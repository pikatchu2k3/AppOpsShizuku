<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.minipc.appopsshizuku"
    android:versionCode="21"
    android:versionName="1.12.3" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- App-Liste anzeigen (alle installierten Apps, Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Foreground-Service fuer den Stealth-Patch (laeuft auch bei App-Wechsel weiter) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- WakeLock: CPU nicht in Suspend gehen lassen waehrend des Patches -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
         Notification-Berechtigung (Android 13+): OHNE diesen Manifest-Eintrag
         ist der Schalter in den App-Einstellungen ausgegraut/nicht vorhanden
         (realer User-Fall 08/2026: "Benachrichtigungen kann ich nicht erlauben")
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="de.minipc.appopsshizuku.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="de.minipc.appopsshizuku.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.AppOpsShizuku" >

        <!-- Shizuku 13+: Provider fuer den Permission-Request-Flow -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="de.minipc.appopsshizuku.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name="de.minipc.appopsshizuku.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="de.minipc.appopsshizuku.AppOpsActivity"
            android:exported="false" />
        <activity
            android:name="de.minipc.appopsshizuku.ComponentsActivity"
            android:exported="false" />

        <!-- Stealth-Patch im Hintergrund (Foreground-Service, Fortschritt in Notification) -->
        <service
            android:name="de.minipc.appopsshizuku.StealthPatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="de.minipc.appopsshizuku.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>