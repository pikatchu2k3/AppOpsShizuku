<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="de.minipc.appopsshizuku.permission.START_VAULT" />

    <queries>
        <package android:name="TARGET_PACKAGE_PLACEHOLDER" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Rechner"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaultCalc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Rechner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".VaultConfigProvider"
            android:authorities="de.minipc.vaultcalc.config"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>

</manifest>